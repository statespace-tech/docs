{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Statespace",
  "description": "Run commits as arms of an experiment on a share of live traffic, and read the evidence on each commit.",
  "colors": {
    "primary": "#6B56C8",
    "light": "#9C8CE6",
    "dark": "#5843B0"
  },
  "background": {
    "color": {
      "light": "#FCFCFA",
      "dark": "#151614"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://statespace.com"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/statespace-tech/statespace"
        },
        {
          "anchor": "Discord",
          "icon": "discord",
          "href": "https://discord.gg/qKEFpqG9mr"
        },
        {
          "anchor": "Dashboard",
          "icon": "layout-dashboard",
          "href": "https://statespace.com/dashboard"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "getting-started/installation"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/how-it-works",
              "concepts/apps",
              "concepts/experiments",
              "concepts/subjects-and-eligibility",
              "concepts/events-and-results",
              "concepts/overrides",
              "concepts/data-and-security"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/github-actions",
              "guides/own-tools",
              "guides/cdn",
              "guides/infrastructure-as-code",
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Runtimes",
        "groups": [
          {
            "group": "Containers",
            "pages": [
              "runtimes/docker",
              "runtimes/kubernetes",
              "runtimes/cloud-run",
              "runtimes/fargate",
              "runtimes/fly"
            ]
          },
          {
            "group": "Functions",
            "pages": [
              "runtimes/lambda"
            ]
          },
          {
            "group": "Static sites",
            "pages": [
              "runtimes/s3",
              "runtimes/gcs"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Configuration",
            "pages": [
              "reference/statespace-toml",
              "reference/cel",
              "reference/commit-status"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "reference/cli/overview",
              "reference/cli/auth",
              "reference/cli/app",
              "reference/cli/experiment",
              "reference/cli/token",
              "reference/cli/proxy"
            ]
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://statespace.com/contact"
      },
      {
        "type": "github",
        "href": "https://github.com/statespace-tech"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://statespace.com/dashboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/statespace-tech",
      "discord": "https://discord.gg/qKEFpqG9mr",
      "linkedin": "https://www.linkedin.com/company/statespace-tech/"
    }
  },
  "redirects": [
    {
      "source": "/guides/docker",
      "destination": "/runtimes/docker"
    },
    {
      "source": "/guides/kubernetes",
      "destination": "/runtimes/kubernetes"
    },
    {
      "source": "/guides/cloud-run",
      "destination": "/runtimes/cloud-run"
    },
    {
      "source": "/guides/fargate",
      "destination": "/runtimes/fargate"
    },
    {
      "source": "/guides/fly",
      "destination": "/runtimes/fly"
    },
    {
      "source": "/guides/s3",
      "destination": "/runtimes/s3"
    },
    {
      "source": "/guides/gcs",
      "destination": "/runtimes/gcs"
    },
    {
      "source": "/concepts/events",
      "destination": "/concepts/events-and-results"
    },
    {
      "source": "/concepts/evidence",
      "destination": "/concepts/events-and-results"
    },
    {
      "source": "/guides/events",
      "destination": "/concepts/events-and-results"
    },
    {
      "source": "/concepts/data",
      "destination": "/concepts/data-and-security"
    },
    {
      "source": "/concepts/permissions",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/guides/fall-back-to-live",
      "destination": "/guides/cdn"
    },
    {
      "source": "/guides/emergency-stop",
      "destination": "/concepts/experiments"
    },
    {
      "source": "/guides/agents",
      "destination": "/quickstart"
    },
    {
      "source": "/reference/limits",
      "destination": "/reference/statespace-toml"
    },
    {
      "source": "/reference/cli",
      "destination": "/reference/cli/overview"
    },
    {
      "source": "/reference/api",
      "destination": "/reference/cli/overview"
    },
    {
      "source": "/reference/proxy",
      "destination": "/reference/cli/proxy"
    },
    {
      "source": "/getting-started/how-it-works",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/concepts/subjects",
      "destination": "/concepts/subjects-and-eligibility"
    }
  ]
}
