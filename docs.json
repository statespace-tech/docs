{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Statespace",
  "description": "Run commits as arms of an experiment on a share of live traffic, and read the evidence on each commit.",
  "colors": {
    "primary": "#6B56C8",
    "light": "#9C8CE6",
    "dark": "#5843B0"
  },
  "background": {
    "color": {
      "light": "#FCFCFA",
      "dark": "#151614"
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://statespace.com"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "getting-started/installation"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/how-it-works",
          "concepts/apps",
          "concepts/experiments",
          "concepts/subjects",
          "concepts/events-and-metrics",
          "concepts/evidence",
          "concepts/overrides",
          "concepts/permissions"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/github-actions",
          "guides/docker",
          "guides/cloud-run",
          "guides/kubernetes",
          "guides/fargate",
          "guides/fly",
          "guides/events-and-metrics",
          "guides/emergency-stop",
          "guides/agents"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/statespace-toml",
          "reference/api",
          "reference/cel",
          "reference/commit-status",
          "reference/limits"
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://statespace.com"
      },
      {
        "type": "github",
        "href": "https://github.com/statespace-tech"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://statespace.com/signup"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/statespace-tech",
      "discord": "https://discord.gg/2jtfwu7xB",
      "linkedin": "https://www.linkedin.com/company/statespace-tech/"
    },
    "links": [
      {
        "header": "Statespace",
        "items": [
          {
            "label": "Website",
            "href": "https://statespace.com"
          },
          {
            "label": "CLI",
            "href": "https://github.com/statespace-tech/statespace"
          }
        ]
      }
    ]
  },
  "fonts": {
    "family": "DM Sans"
  },
  "redirects": [
    {
      "source": "/reference/host",
      "destination": "/reference/cli"
    },
    {
      "source": "/reference/proxy",
      "destination": "/reference/cli"
    },
    {
      "source": "/reference/controller",
      "destination": "/guides/kubernetes"
    },
    {
      "source": "/reference/experiment-definition",
      "destination": "/reference/statespace-toml"
    },
    {
      "source": "/reference/database-schema",
      "destination": "/concepts/events-and-metrics"
    },
    {
      "source": "/getting-started/how-it-works",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/getting-started/deployment",
      "destination": "/guides/docker"
    },
    {
      "source": "/concepts/random-sampling",
      "destination": "/concepts/subjects"
    },
    {
      "source": "/concepts/treatments-and-control-groups",
      "destination": "/concepts/experiments"
    },
    {
      "source": "/concepts/random-assignment",
      "destination": "/concepts/subjects"
    },
    {
      "source": "/concepts/outcome-measures",
      "destination": "/concepts/events-and-metrics"
    },
    {
      "source": "/concepts/statistical-inference",
      "destination": "/concepts/evidence"
    },
    {
      "source": "/workflow/:slug*",
      "destination": "/quickstart"
    },
    {
      "source": "/examples/:slug*",
      "destination": "/guides/events-and-metrics"
    },
    {
      "source": "/concepts/arms",
      "destination": "/concepts/experiments"
    },
    {
      "source": "/concepts/holds",
      "destination": "/guides/emergency-stop"
    }
  ]
}
